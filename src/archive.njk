---
layout: layouts/base.njk
title: Archive
permalink: /archive/
eleventyNavigation:
  key: Archive
  order: 3
---
<div class="max-w-3xl mx-auto px-4 py-12">
  <h1 class="text-4xl font-bold text-gray-900 dark:text-slate-50 mb-8">Archive</h1>

  {% for yearData in collections.postsByYear %}
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-slate-50 mb-4">
      <a href="/{{ yearData.year }}/" class="hover:text-primary dark:hover:text-primary-light transition-colors">
        {{ yearData.year }}
      </a>
      <span class="text-base font-normal text-gray-500 dark:text-slate-400">({{ yearData.posts.length }} post{% if yearData.posts.length != 1 %}s{% endif %})</span>
    </h2>

    <div class="flex flex-wrap gap-2">
      {% set months = [] %}
      {% for monthData in collections.postsByYearMonth %}
        {% if monthData.year == yearData.year %}
        <a href="/{{ monthData.year }}/{{ monthData.month }}/" class="inline-block px-3 py-1 bg-gray-100 hover:bg-primary hover:text-white dark:bg-slate-700 dark:hover:bg-primary-light dark:hover:text-slate-900 rounded-full text-sm transition-colors">
          {{ monthData.monthName }} <span class="text-gray-500 dark:text-slate-400">({{ monthData.posts.length }})</span>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </section>
  {% endfor %}
</div>
