---
layout: layouts/base.njk
pagination:
  data: collections.postsByYearMonth
  size: 1
  alias: monthData
permalink: /{{ monthData.year }}/{{ monthData.month }}/
eleventyComputed:
  title: "{{ monthData.monthName }} {{ monthData.year }} Archive"
---
<div class="max-w-3xl mx-auto px-4 py-12">
  <h1 class="text-4xl font-bold text-gray-900 dark:text-slate-50 mb-2">{{ monthData.monthName }} {{ monthData.year }}</h1>
  <p class="text-gray-500 dark:text-slate-400 mb-8">{{ monthData.posts.length }} post{% if monthData.posts.length != 1 %}s{% endif %}</p>

  <ul class="space-y-6">
    {% for post in monthData.posts %}
    <li class="border-b border-gray-200 dark:border-slate-700 pb-6 last:border-0">
      <article>
        <h2 class="text-xl font-semibold mb-1">
          <a href="{{ post.url }}" class="text-gray-900 hover:text-primary dark:text-slate-50 dark:hover:text-primary-light transition-colors">
            {{ post.data.title }}
          </a>
        </h2>
        <time datetime="{{ post.date | isoDate }}" class="text-sm text-gray-500 dark:text-slate-400">
          {{ post.date | readableDate }}
        </time>
      </article>
    </li>
    {% endfor %}
  </ul>

  {% set monthToots = collections.toots | tootsForMonth(monthData.year, monthData.month) %}
  {% if monthToots.length > 0 %}
  <section class="mt-12 pt-8 border-t border-gray-200 dark:border-slate-700">
    <h2 class="text-2xl font-semibold text-gray-800 dark:text-slate-100 mb-4">Toots</h2>
    {% for toot in monthToots %}
      {% include "toot-card.njk" %}
    {% endfor %}
  </section>
  {% endif %}

  <p class="mt-12">
    <a href="/{{ monthData.year }}/" class="text-primary hover:underline dark:text-primary-light">&larr; All of {{ monthData.year }}</a>
  </p>
</div>
