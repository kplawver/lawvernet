<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ site.title }}</title>
  <meta name="description" content="{{ site.description }}">

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#2563eb',
            'primary-dark': '#1d4ed8',
          },
          fontFamily: {
            sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
            serif: ['Merriweather', 'ui-serif', 'Georgia', 'serif'],
          }
        }
      }
    }
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed/">

  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: #2563eb;
      color: white;
      padding: 8px 16px;
      z-index: 100;
      transition: top 0.3s;
    }
    .skip-link:focus {
      top: 0;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-gray-50 text-gray-900">
  <a href="#main-content" class="skip-link">Skip to content</a>

  <main id="main-content" class="flex-grow">
    <div class="max-w-3xl mx-auto px-4 py-16">
      <header class="mb-12">
        <h1 class="text-5xl font-bold text-gray-900 mb-4">{{ site.title }}</h1>
        <p class="text-xl text-gray-600 mb-8">{{ site.description }}</p>
        <nav>
          <ul class="flex items-center gap-6">
            <li>
              <a href="/about/" class="text-gray-600 hover:text-primary transition-colors">
                About
              </a>
            </li>
            <li>
              <a href="/tags/" class="text-gray-600 hover:text-primary transition-colors{% if page.url == '/tags/' %} text-primary font-medium{% endif %}">
                Tags
              </a>
            </li>
            <li>
              <a href="/feed/" class="text-gray-600 hover:text-primary transition-colors" title="RSS Feed">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3z"/>
                  <path d="M4 9a1 1 0 011-1 7 7 0 017 7 1 1 0 11-2 0 5 5 0 00-5-5 1 1 0 01-1-1z"/>
                  <circle cx="5" cy="15" r="2"/>
                </svg>
              </a>
            </li>
          </ul>
        </nav>
      </header>

      {{ content | safe }}
    </div>
  </main>

  <footer class="bg-white border-t border-gray-200 mt-16">
    <div class="max-w-4xl mx-auto px-4 py-8">
      <p class="text-center text-gray-500 text-sm">
        &copy; {{ page.date | htmlDateString | truncate(4, true, '') }} {{ site.author.name }}.
        Built with <a href="https://www.11ty.dev/" class="text-primary hover:underline">Eleventy</a>.
      </p>
    </div>
  </footer>
</body>
</html>
