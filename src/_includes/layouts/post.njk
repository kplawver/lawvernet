---
layout: layouts/base.njk
---
<article class="max-w-3xl mx-auto px-4 py-12" data-pagefind-body>

  <h1 class="section-title font-display mb-10" style="--section-title-bg: var(--comic-red);" data-pagefind-meta="title">{{ title }}</h1>

  <div class="comic-panel p-8">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-gray-500 dark:text-slate-400 mb-8">
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      {% if tags %}
      <div class="flex flex-wrap items-center gap-2" data-pagefind-ignore>
        <span class="text-gray-400 dark:text-slate-500">|</span>
        {% for tag in tags %}
          {% if tag != "posts" %}
          <a href="/tags/{{ tag | slugify }}/" class="text-sm bg-gray-100 hover:bg-gray-200 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-slate-200 px-2 py-1 rounded transition-colors" data-pagefind-filter="tag">
            {{ tag | humanizeTag }}
          </a>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="prose prose-lg prose-gray dark:prose-invert max-w-none dark:prose-a:text-primary-light dark:prose-headings:text-slate-50 dark:prose-strong:text-slate-50 dark:prose-code:text-slate-200">
      {{ content | safe }}
    </div>
  </div>

  {% set dayToots = collections.toots | tootsForDate(date) %}
  {% if dayToots.length > 0 %}
  <aside class="mt-12 pt-8 border-t border-gray-200 dark:border-slate-700">
    <h2 class="section-title font-display mb-6" style="--section-title-bg: var(--comic-green); font-size: clamp(1.25rem, 3vw, 2rem); transform: rotate(-2deg);">Also on {{ date | readableDate }}</h2>
    {% for toot in dayToots %}
      {% include "toot-card.njk" %}
    {% endfor %}
  </aside>
  {% endif %}

  <nav class="comic-panel mt-12 p-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      {% set previousPost = collections.posts | getPreviousCollectionItem %}
      {% set nextPost = collections.posts | getNextCollectionItem %}

      {% if previousPost %}
      <a href="{{ previousPost.url }}" class="group flex items-center gap-2 text-gray-600 hover:text-primary dark:text-slate-300 dark:hover:text-primary-light transition-colors">
        <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        <span class="max-w-[200px] truncate">{{ previousPost.data.title }}</span>
      </a>
      {% else %}
      <span></span>
      {% endif %}

      <a href="/{{ date | yearMonth }}/" class="text-gray-500 hover:text-primary dark:text-slate-400 dark:hover:text-primary-light transition-colors">
        {{ date | monthYearShort }}
      </a>

      {% if nextPost %}
      <a href="{{ nextPost.url }}" class="group flex items-center gap-2 text-gray-600 hover:text-primary dark:text-slate-300 dark:hover:text-primary-light transition-colors">
        <span class="max-w-[200px] truncate">{{ nextPost.data.title }}</span>
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
      {% else %}
      <span></span>
      {% endif %}
    </div>
  </nav>
</article>
