---
layout: layouts/home.njk
eleventyNavigation:
  key: Home
  order: 1
---
<section>
  <h2 class="text-2xl font-bold text-gray-900 dark:text-slate-50 mb-8">Recent Posts</h2>

    {% if collections.posts.length > 0 %}
    <ul class="space-y-8">
      {% for post in collections.posts | head(10) %}
      <li class="border-b border-gray-200 dark:border-slate-700 pb-8 last:border-0">
        <article>
          <h3 class="text-xl font-semibold mb-2">
            <a href="{{ post.url }}" class="text-gray-900 hover:text-primary dark:text-slate-50 dark:hover:text-primary-light transition-colors">
              {{ post.data.title }}
            </a>
          </h3>
          <time datetime="{{ post.date | isoDate }}" class="text-sm text-gray-500 dark:text-slate-400 mb-3 block">
            {{ post.date | readableDate }}
          </time>
          {% if post.data.description %}
          <p class="text-gray-600 dark:text-slate-300">{{ post.data.description }}</p>
          {% else %}
          <p class="text-gray-600 dark:text-slate-300">{{ post.content | excerpt }}</p>
          {% endif %}
        </article>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="text-gray-500 dark:text-slate-400 italic">No posts yet. Create your first post in <code class="bg-gray-100 dark:bg-slate-700 dark:text-slate-200 px-2 py-1 rounded">src/posts/</code></p>
    {% endif %}
</section>
