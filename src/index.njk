---
layout: layouts/home.njk
eleventyNavigation:
  key: Home
  order: 1
---
<div class="max-w-7xl mx-auto px-4 py-10 grid gap-12 lg:grid-cols-2">
  <section aria-labelledby="recent-posts">
    <h2 id="recent-posts" class="section-title font-display mb-6">Recent Posts</h2>
    {% if collections.posts.length > 0 %}
    <ul class="space-y-6">
      {% for post in collections.posts | head(20) %}
      <li class="panel p-6">
        <article>
          <h3 class="text-xl font-display font-medium mb-2">
            <a href="{{ post.url }}" class="text-gray-900 hover:text-primary dark:text-slate-50 dark:hover:text-primary transition-colors">{{ post.data.title }}</a>
          </h3>
          <time datetime="{{ post.date | isoDate }}" class="block text-sm text-gray-500 dark:text-slate-400 mb-3">{{ post.date | readableDate }}</time>
          <p class="text-gray-600 dark:text-slate-300">{% if post.data.description %}{{ post.data.description }}{% else %}{{ post.content | excerpt }}{% endif %}</p>
        </article>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="text-gray-500 dark:text-slate-400 italic">No posts yet.</p>
    {% endif %}
  </section>

  <aside class="space-y-10 min-w-0">
    <section aria-labelledby="activity-heading">
      <h2 id="activity-heading" class="section-title font-display mb-6">Activity</h2>
      <div id="social-stream" class="panel">
        <noscript>
          <ul class="p-5 space-y-3 text-sm">
            <li><a class="text-primary hover:underline" href="https://www.crucialtracks.org/profile/kpl">Crucial Tracks</a></li>
            <li><a class="text-primary hover:underline" rel="me" href="https://social.lol/@kpl">@kpl@social.lol on Mastodon</a></li>
            <li><a class="text-primary hover:underline" href="https://photos.lawver.net">Kevin’s Photos</a></li>
          </ul>
        </noscript>
      </div>
    </section>

    <section aria-labelledby="photos-heading">
      <h2 id="photos-heading" class="section-title font-display mb-6">Photos</h2>
      <div class="panel overflow-hidden h-fit">
        <iframe
          src="https://www.moments.im/embed/kpl?columns=2&bg=%23020202"
          title="Kevin’s Photos · Moments"
          loading="lazy"
          style="display: block; width: 100%; height: 2109px; border: 0;"
        ></iframe>
      </div>
      <script async src="https://www.moments.im/embed.js"></script>
    </section>
  </aside>
</div>
