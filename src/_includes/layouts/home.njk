<!DOCTYPE html>
<html lang="en" class="scroll-smooth" x-data="siteApp" :class="{ 'dark': darkMode }">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ site.title }}</title>
  <meta name="description" content="{{ site.description }}">

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
  <script src="/assets/js/tailwind.config.js"></script>

  <!-- Site JS (Alpine component registration) + Alpine.js -->
  <script defer src="/assets/js/site.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Contrail+One&family=Radio+Canada:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

  <!-- Canonical URL -->
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- Favicon -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ site.title }}">
  <meta property="og:description" content="{{ site.description }}">
  <meta property="og:image" content="{{ site.url }}/assets/og-image.jpg">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ site.title }}">
  <meta name="twitter:description" content="{{ site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/assets/og-image.jpg">

  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">

  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body class="min-h-screen flex flex-col bg-[#FEF9EE] text-gray-900 dark:bg-slate-900 dark:text-slate-50 transition-colors duration-200 relative">
  <div class="comic-bg" aria-hidden="true" x-init="
    const colors = ['comic-color-red','comic-color-yellow','comic-color-blue','comic-color-orange','comic-color-green'];
    $el.querySelectorAll('.comic-bubble').forEach(b => b.classList.add(colors[Math.floor(Math.random() * colors.length)]));
  ">
    <!-- Top row -->
    <span class="comic-bubble" style="--rot:-15deg; top:-2%;   left:-2%;  width:clamp(365px,56vw,820px)">{% include "svg/boom.svg" %}</span>
    <span class="comic-bubble" style="--rot:10deg;  top:1%;    left:18%;  width:clamp(270px,44vw,660px)">{% include "svg/poof.svg" %}</span>
    <span class="comic-bubble" style="--rot:-8deg;  top:-1%;   left:38%;  width:clamp(320px,50vw,750px)">{% include "svg/crash.svg" %}</span>
    <span class="comic-bubble" style="--rot:18deg;  top:2%;    right:12%; width:clamp(290px,46vw,700px)">{% include "svg/pow.svg" %}</span>
    <span class="comic-bubble" style="--rot:-12deg; top:-3%;   right:-2%; width:clamp(380px,58vw,850px)">{% include "svg/kaboom.svg" %}</span>
    <!-- Upper-middle row -->
    <span class="comic-bubble" style="--rot:30deg;  top:15%;   left:5%;   width:clamp(240px,40vw,600px)">{% include "svg/ouch.svg" %}</span>
    <span class="comic-bubble" style="--rot:-22deg; top:12%;   left:30%;  width:clamp(290px,46vw,700px)">{% include "svg/smash.svg" %}</span>
    <span class="comic-bubble" style="--rot:8deg;   top:10%;   right:22%; width:clamp(310px,48vw,720px)">{% include "svg/bang.svg" %}</span>
    <span class="comic-bubble" style="--rot:-30deg; top:14%;   right:4%;  width:clamp(270px,44vw,660px)">{% include "svg/wham.svg" %}</span>
    <!-- Middle row -->
    <span class="comic-bubble" style="--rot:12deg;  top:35%;   left:-2%;  width:clamp(350px,54vw,800px)">{% include "svg/zap.svg" %}</span>
    <span class="comic-bubble" style="--rot:-18deg; top:32%;   left:20%;  width:clamp(290px,46vw,700px)">{% include "svg/pow.svg" %}</span>
    <span class="comic-bubble" style="--rot:25deg;  top:30%;   left:44%;  width:clamp(365px,56vw,820px)">{% include "svg/boom.svg" %}</span>
    <span class="comic-bubble" style="--rot:-8deg;  top:35%;   right:14%; width:clamp(300px,47vw,710px)">{% include "svg/crash.svg" %}</span>
    <span class="comic-bubble" style="--rot:15deg;  top:33%;   right:-2%; width:clamp(320px,50vw,750px)">{% include "svg/kaboom.svg" %}</span>
    <!-- Lower-middle row -->
    <span class="comic-bubble" style="--rot:-25deg; top:58%;   left:2%;   width:clamp(270px,44vw,660px)">{% include "svg/poof.svg" %}</span>
    <span class="comic-bubble" style="--rot:18deg;  top:55%;   left:22%;  width:clamp(335px,52vw,780px)">{% include "svg/smash.svg" %}</span>
    <span class="comic-bubble" style="--rot:-10deg; top:60%;   left:48%;  width:clamp(290px,46vw,700px)">{% include "svg/ouch.svg" %}</span>
    <span class="comic-bubble" style="--rot:28deg;  top:56%;   right:16%; width:clamp(310px,48vw,720px)">{% include "svg/wham.svg" %}</span>
    <span class="comic-bubble" style="--rot:-15deg; top:58%;   right:-2%; width:clamp(350px,54vw,800px)">{% include "svg/bang.svg" %}</span>
    <!-- Bottom row -->
    <span class="comic-bubble" style="--rot:20deg;  bottom:-3%; left:-2%;  width:clamp(400px,62vw,900px)">{% include "svg/kaboom.svg" %}</span>
    <span class="comic-bubble" style="--rot:-12deg; bottom:0%;  left:22%;  width:clamp(290px,46vw,700px)">{% include "svg/zap.svg" %}</span>
    <span class="comic-bubble" style="--rot:8deg;   bottom:-2%; left:45%;  width:clamp(350px,54vw,800px)">{% include "svg/boom.svg" %}</span>
    <span class="comic-bubble" style="--rot:-20deg; bottom:2%;  right:18%; width:clamp(310px,48vw,720px)">{% include "svg/pow.svg" %}</span>
    <span class="comic-bubble" style="--rot:15deg;  bottom:-2%; right:-2%; width:clamp(365px,56vw,820px)">{% include "svg/crash.svg" %}</span>
    <!-- Gap fillers -->
    <span class="comic-bubble" style="--rot:-35deg; top:22%;   left:14%;  width:clamp(240px,40vw,600px)">{% include "svg/smash.svg" %}</span>
    <span class="comic-bubble" style="--rot:22deg;  top:20%;   right:35%; width:clamp(240px,40vw,600px)">{% include "svg/poof.svg" %}</span>
    <span class="comic-bubble" style="--rot:-18deg; top:72%;   left:12%;  width:clamp(270px,44vw,660px)">{% include "svg/wham.svg" %}</span>
    <span class="comic-bubble" style="--rot:30deg;  top:75%;   right:10%; width:clamp(240px,40vw,600px)">{% include "svg/ouch.svg" %}</span>
  </div>
  <a href="#main-content" class="skip-link">Skip to content</a>

  <main id="main-content" class="flex-grow relative z-10">

    <!-- Full-width comic book masthead -->
    <header class="w-full border-y-[5px] border-[#111827] dark:border-amber-400 bg-[#FEF9EE] dark:bg-slate-900 relative">
      <!-- Nav row -->
      <div class="flex items-center justify-between px-6 pt-4 pb-2">
        <span class="text-xs font-sans uppercase tracking-[0.2em] text-gray-400 dark:text-slate-500">Est. 2000 · Vol. 1</span>
        <nav>
          <ul class="hidden md:flex items-center gap-6">
            {% include "nav-links.njk" %}
          </ul>
          <button @click="mobileMenuOpen = !mobileMenuOpen" class="md:hidden text-gray-600 hover:text-primary dark:text-slate-300 dark:hover:text-primary-light transition-colors" aria-label="Toggle menu" :aria-expanded="mobileMenuOpen">
            <svg x-show="!mobileMenuOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg x-show="mobileMenuOpen" x-cloak class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
          <div x-show="mobileMenuOpen" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="opacity-100 translate-y-0" x-transition:leave-end="opacity-0 -translate-y-2" class="absolute right-4 top-16 bg-white dark:bg-slate-800 border-2 border-[#111827] dark:border-amber-400 shadow-[4px_4px_0_#111827] dark:shadow-[4px_4px_0_theme(colors.amber.400)] p-4 z-20">
            <ul class="flex flex-col gap-4">
              {% include "nav-links.njk" %}
            </ul>
          </div>
        </nav>
      </div>

      <!-- Giant title -->
      <div class="text-center py-10 px-4">
        <h1 class="masthead-title font-display">{{ site.title }}</h1>
        <p class="text-lg mt-8 font-sans text-gray-600 dark:text-slate-300 max-w-xl mx-auto">{{ site.description }}</p>
      </div>
    </header>

    <!-- Post list content -->
    <div class="max-w-3xl mx-auto px-4 py-10">
      {{ content | safe }}
    </div>

  </main>

  <footer class="bg-white border-t border-gray-200 mt-16 dark:bg-slate-800 dark:border-slate-700 relative z-10">
    <div class="max-w-4xl mx-auto px-4 py-8">
      {% include "footer-search.njk" %}
      {% include "footer-social.njk" %}
      <p class="text-center text-gray-500 dark:text-slate-400 text-sm">
        &copy; {{ page.date | htmlDateString | truncate(4, true, '') }} {{ site.author.name }}.
        Built with <a href="https://www.11ty.dev/" class="text-primary hover:underline dark:text-primary-light">Eleventy</a>.
      </p>
    </div>
  </footer>
</body>
</html>
