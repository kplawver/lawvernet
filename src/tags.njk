---
layout: layouts/base.njk
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
permalink: /tags/{{ tag | slugify }}/
eleventyComputed:
  title: "Tagged: {{ tag }}"
---
<div class="max-w-3xl mx-auto px-4 py-12">
  <h1 class="text-4xl font-bold text-gray-900 mb-2">{{ tag | humanizeTag }}</h1>
  <p class="text-gray-500 mb-8">{{ collections[tag].length }} post{% if collections[tag].length != 1 %}s{% endif %}</p>

  <ul class="space-y-6">
    {% for post in collections[tag] | reverse %}
    <li class="border-b border-gray-200 pb-6 last:border-0">
      <article>
        <h2 class="text-xl font-semibold mb-1">
          <a href="{{ post.url }}" class="text-gray-900 hover:text-primary transition-colors">
            {{ post.data.title }}
          </a>
        </h2>
        <time datetime="{{ post.date | isoDate }}" class="text-sm text-gray-500">
          {{ post.date | readableDate }}
        </time>
      </article>
    </li>
    {% endfor %}
  </ul>

  <p class="mt-12">
    <a href="/tags/" class="text-primary hover:underline">&larr; All tags</a>
  </p>
</div>
