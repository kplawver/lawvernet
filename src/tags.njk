---
layout: layouts/base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag }}/
eleventyComputed:
  title: "Tagged: {{ collections.tagList[tag].name }}"
---
<div class="max-w-3xl mx-auto px-4 py-12">
  <h1 class="text-4xl font-bold text-gray-900 dark:text-slate-50 mb-2">{{ collections.tagList[tag].name | humanizeTag }}</h1>
  <p class="text-gray-500 dark:text-slate-400 mb-8">{{ collections.tagList[tag].items.length }} item{% if collections.tagList[tag].items.length != 1 %}s{% endif %}</p>

  <ul class="space-y-6">
    {% for post in collections.tagList[tag].items %}
    <li class="border-b border-gray-200 dark:border-slate-700 pb-6 last:border-0">
      {% if post.data.mastodonId %}
        {% set toot = post %}
        {% include "toot-card.njk" %}
      {% else %}
      <article>
        <h2 class="text-xl font-semibold mb-1">
          <a href="{{ post.url }}" class="text-gray-900 hover:text-primary dark:text-slate-50 dark:hover:text-primary-light transition-colors">
            {{ post.data.title }}
          </a>
        </h2>
        <time datetime="{{ post.date | isoDate }}" class="text-sm text-gray-500 dark:text-slate-400">
          {{ post.date | readableDate }}
        </time>
      </article>
      {% endif %}
    </li>
    {% endfor %}
  </ul>

  <p class="mt-12">
    <a href="/tags/" class="text-primary hover:underline dark:text-primary-light">&larr; All tags</a>
  </p>
</div>
