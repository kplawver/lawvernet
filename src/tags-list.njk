---
layout: layouts/base.njk
title: All Tags
permalink: /tags/
---
<div class="max-w-3xl mx-auto px-4 py-12">
  <h1 class="text-4xl font-bold text-gray-900 mb-8">All Tags</h1>

  <ul class="flex flex-wrap gap-3">
    {% for tag, posts in collections | dictsort %}
      {% if tag != "all" %}
      <li>
        <a href="/tags/{{ tag | slugify }}/" class="inline-block bg-gray-100 hover:bg-gray-200 px-3 py-2 rounded transition-colors">
          {{ tag | humanizeTag }} <span class="text-gray-500">({{ posts.length }})</span>
        </a>
      </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>
