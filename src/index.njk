---
layout: layouts/base.njk
title: Home
---
<div class="max-w-3xl mx-auto px-4 py-12">
  <section class="mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">{{ site.title }}</h1>
    <p class="text-xl text-gray-600">{{ site.description }}</p>
  </section>

  <section>
    <h2 class="text-2xl font-bold text-gray-900 mb-8">Recent Posts</h2>

    {% if collections.posts.length > 0 %}
    <ul class="space-y-8">
      {% for post in collections.posts | head(10) %}
      <li class="border-b border-gray-200 pb-8 last:border-0">
        <article>
          <h3 class="text-xl font-semibold mb-2">
            <a href="{{ post.url }}" class="text-gray-900 hover:text-primary transition-colors">
              {{ post.data.title }}
            </a>
          </h3>
          <time datetime="{{ post.date | isoDate }}" class="text-sm text-gray-500 mb-3 block">
            {{ post.date | readableDate }}
          </time>
          {% if post.data.description %}
          <p class="text-gray-600">{{ post.data.description }}</p>
          {% else %}
          <p class="text-gray-600">{{ post.content | excerpt }}</p>
          {% endif %}
        </article>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="text-gray-500 italic">No posts yet. Create your first post in <code class="bg-gray-100 px-2 py-1 rounded">src/posts/</code></p>
    {% endif %}
  </section>
</div>
