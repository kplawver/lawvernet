<div class="mb-8 max-w-md mx-auto">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-slate-400 mb-3 text-center">Search</h2>
  <div id="search"></div>
</div>
<script>
  // Only load pagefind assets if the index exists (not available in dev server mode)
  (function() {
    var s = document.createElement('script');
    s.src = '/pagefind/pagefind-ui.js';
    s.onload = function() {
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(link);
      new PagefindUI({ element: '#search', showSubResults: false, showImages: false, resetStyles: false });
    };
    s.onerror = function() {
      var el = document.getElementById('search');
      if (el) el.style.display = 'none';
    };
    document.head.appendChild(s);
  })();
</script>
