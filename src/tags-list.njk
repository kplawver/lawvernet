---
layout: layouts/base.njk
title: All Tags
permalink: /tags/
eleventyNavigation:
  key: Tags
  parent: Archive
---
<div class="max-w-3xl mx-auto px-4 py-12">
  <h1 class="text-4xl font-bold text-gray-900 dark:text-slate-50 mb-8">All Tags</h1>

  <ul class="flex flex-wrap gap-3">
    {% for tag, posts in collections | dictsort %}
      {% if tag not in ["all", "posts", "postsByYear", "postsByYearMonth"] %}
      <li>
        <a href="/tags/{{ tag | slugify }}/" class="inline-block bg-gray-100 hover:bg-gray-200 dark:bg-slate-700 dark:hover:bg-slate-600 dark:text-slate-200 px-3 py-2 rounded transition-colors">
          {{ tag | humanizeTag }} <span class="text-gray-500 dark:text-slate-400">({{ posts.length }})</span>
        </a>
      </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>
